# Agent 评测平台 · 环境变量模板
# 用法：复制为 .env 并填写真实值，启动时 docker run --env-file ./.env agent-eval:1.0
# 说明：本文件为模板（可提交 git），真实值填在 .env（已 gitignore，勿提交）
# 格式要求：纯 KEY=VALUE，不支持 export / 多行值 / 变量引用

# ============ 必填 ============

# ---- PostgreSQL ----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=agent_eval

# ---- Redis（任务队列 / 分布式锁 / 限流）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- LLM 评测模型（不填则评测功能不可用）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
