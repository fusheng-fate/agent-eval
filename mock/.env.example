# Mock 被测智能体服务配置示例
# 复制为 .env 后填写真实值

# ---- 服务 ----
MOCK_HOST=0.0.0.0
MOCK_PORT=8100
CORS_ORIGINS=*

# ---- 被模拟的 LLM（OpenAI 兼容 /chat/completions）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ---- 会话 ----
SESSION_TTL_SECONDS=3600
SESSION_MAX_TURNS=50

# ---- 模拟智能体人设（可选，默认见 config.py）----
# AGENT_SYSTEM_PROMPT=你是一个模拟的待测智能体……
